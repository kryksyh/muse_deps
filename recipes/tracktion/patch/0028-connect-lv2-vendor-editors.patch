+    class ExternalUiConnection final : public UiConnection,
+                                       public std::enable_shared_from_this<ExternalUiConnection>
+    {
+    public:
+        ExternalUiConnection (LV2AudioPluginInstanceHeadless& p, UiCallbacks c)
+            : owner (&p), callbacks (std::move (c)) {}
+
+        ~ExternalUiConnection() override { disconnect(); }
+
+        void* getInstanceHandle() const override
+        {
+            return owner != nullptr ? owner->instance->instance.getHandle() : nullptr;
+        }
+
+        ExtensionData getExtensionDataFunction() const override
+        {
+            return owner != nullptr ? owner->instance->instance.getExtensionDataCallback() : nullptr;
+        }
+
+        std::vector<UiFeature> getFeatures() const override
+        {
+            std::vector<UiFeature> result;
+            if (owner != nullptr)
+                for (auto feature = owner->instance->features.getFeatureArray(); *feature != nullptr; ++feature)
+                    result.push_back ({ String::fromUTF8 ((*feature)->URI), (*feature)->data });
+
+            return result;
+        }
+
+        uint32_t getPortIndex (const String& symbol) const override
+        {
+            uint32_t result = LV2UI_INVALID_PORT_INDEX;
+            if (owner != nullptr)
+                owner->instance->ports.forEachPort ([&] (const PortHeader& port)
+                {
+                    if (port.symbol == symbol)
+                        result = port.index;
+                });
+
+            return result;
+        }
+
+        bool writePort (uint32_t port, uint32_t size, uint32_t protocol, const void* data) override
+        {
+            JUCE_ASSERT_MESSAGE_THREAD;
+            if (owner == nullptr || data == nullptr)
+                return false;
+
+            const ScopedLock lock (owner->getCallbackLock());
+            const auto& urids = owner->instance->urids;
+            if (protocol == 0 || protocol == owner->instance->symap->map (LV2_UI__floatProtocol))
+                return size == sizeof (float) && owner->setControlPortValue (port, readUnaligned<float> (data));
+
+            const auto* atomPort = port < owner->atomPorts.size() ? owner->atomPorts[port] : nullptr;
+            if (atomPort == nullptr || atomPort->header.direction != Port::Direction::input
+                || (protocol != urids.mLV2_ATOM__eventTransfer && protocol != owner->instance->symap->map (LV2_ATOM__atomTransfer))
+                || convertToAtomPtr (data, size) == nullptr)
+                return false;
+
+            owner->instance->uiToProcessor.pushMessage ({ port, protocol }, size, data);
+            return true;
+        }
+
+        void dispatchEvents (const PortEvent& callback) override
+        {
+            JUCE_ASSERT_MESSAGE_THREAD;
+            const auto keepAlive = shared_from_this();
+            if (owner == nullptr)
+                return;
+
+            std::vector<std::pair<uint32_t, float>> values;
+            {
+                const ScopedLock lock (owner->getCallbackLock());
+                for (const auto& port : owner->instance->ports.getControlPorts())
+                    if (const auto value = owner->getControlPortValue (port.header.index))
+                        values.emplace_back (port.header.index, *value);
+            }
+
+            for (const auto& pair : values)
+            {
+                if (owner == nullptr)
+                    return;
+
+                const auto found = lastValues.find (pair.first);
+                if (found == lastValues.end() || found->second != pair.second)
+                {
+                    lastValues[pair.first] = pair.second;
+                    callback (pair.first, sizeof (float), 0, &pair.second);
+                }
+            }
+
+            if (owner != nullptr)
+            {
+                const auto token = owner->externalUiToken.load();
+                owner->externalUiMessages.readAllAndClear ([&] (const ExternalUiMessage& message, uint32_t size, const void* data)
+                {
+                    if (owner != nullptr && token == message.token)
+                        callback (message.header.portIndex, size, message.header.protocol, data);
+                });
+            }
+        }
+
+        void disconnect() override
+        {
+            JUCE_ASSERT_MESSAGE_THREAD;
+            if (owner != nullptr)
+            {
+                owner->externalUiToken.store (0);
+                owner->externalUi.reset();
+                owner = nullptr;
+                callbacks = {};
+            }
+        }
+
+        void beforeInstanceChange()
+        {
+            if (owner != nullptr)
+                owner->externalUiToken.store (0);
+
+            if (callbacks.instanceChanging)
+            {
+                const auto callback = callbacks.instanceChanging;
+                callback();
+            }
+        }
+
+        void afterInstanceChange()
+        {
+            if (owner != nullptr)
+                owner->externalUiToken.store (++owner->nextExternalUiToken);
+
+            lastValues.clear();
+            if (callbacks.instanceChanged)
+            {
+                const auto callback = callbacks.instanceChanged;
+                callback();
+            }
+        }
+
+    private:
+        LV2AudioPluginInstanceHeadless* owner;
+        UiCallbacks callbacks;
+        std::map<uint32_t, float> lastValues;
+    };
