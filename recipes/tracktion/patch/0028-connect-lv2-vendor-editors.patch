+            const auto uri = lilv_ui_get_uri (ui);
+            lilv_world_load_resource (world->get(), uri);
+            UiDescription description;
+            description.uri = lilvNodeToUriString (uri);
+            description.bundlePath = bundlePathFromUri (lilv_node_as_uri (lilv_ui_get_bundle_uri (ui))).getFullPathName();
+            description.binaryPath = bundlePathFromUri (lilv_node_as_uri (lilv_ui_get_binary_uri (ui))).getFullPathName();
+
+            for (const auto* type : world->findNodes (uri, world->newUri (LILV_NS_RDF "type").get(), nullptr))
+                description.types.add (lilvNodeToUriString (type));
+
+            for (const auto* feature : world->findNodes (uri, world->newUri (LV2_CORE__requiredFeature).get(), nullptr))
+                description.requiredFeatures.add (lilvNodeToUriString (feature));
+
+            result.push_back (std::move (description));
+        }
+
+        return result;
+    }
