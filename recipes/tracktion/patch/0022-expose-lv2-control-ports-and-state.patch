+    std::vector<ControlPortInfo> getControlPorts() const override
+    {
+        std::vector<ControlPortInfo> result;
+
+        for (const auto& port : instance->ports.getControlPorts())
+        {
+            const auto source = plugin.getPortByIndex (port.header.index);
+            ControlPortInfo info;
+            info.index = port.header.index;
+            info.name = port.header.name;
+            info.symbol = port.header.symbol;
+            info.minimum = port.info.min;
+            info.maximum = port.info.max;
+            info.defaultValue = port.info.defaultValue;
+            info.isInput = port.header.direction == Port::Direction::input;
+            info.isToggle = info.isInput && port.info.isToggle;
+            info.isInteger = info.isInput && port.info.isInteger;
+            info.isEnumeration = info.isInput && port.info.isEnum;
+            info.isSampleRate = info.isInput && port.info.isSampleRate;
+            info.isTrigger = info.isInput && source.hasProperty (world->newUri (LV2_PORT_PROPS__trigger));
+            info.isLogarithmic = info.isInput && source.hasProperty (world->newUri (LV2_PORT_PROPS__logarithmic));
+            info.hasMinimum = source.get (world->newUri (LV2_CORE__minimum).get()) != nullptr;
+            info.hasMaximum = source.get (world->newUri (LV2_CORE__maximum).get()) != nullptr;
+
+            if (const auto group = source.get (world->newUri (LV2_PORT_GROUPS__group).get()))
+            {
+                info.group = lilvNodeToString (world->get (group.get(), world->newUri (LILV_NS_RDFS "label").get(), nullptr).get());
+
+                if (info.group.isEmpty())
+                    info.group = lilvNodeToString (world->get (group.get(), world->newUri (LV2_CORE__name).get(), nullptr).get());
+
+                if (info.group.isEmpty())
+                    info.group = lilvNodeToUriString (group.get());
+            }
+
+            if (const auto unit = source.get (world->newUri (LV2_UNITS__unit).get()))
+            {
+                const OwningNode symbol { lilv_world_get_symbol (world->get(), unit.get()) };
+                info.units = lilvNodeToString (symbol.get());
+            }
+
+            for (const auto& point : port.info.scalePoints)
+                info.scalePoints.emplace_back (point.value, point.label);
+
+            result.push_back (std::move (info));
+        }
+
+        return result;
+    }
+
+    std::optional<float> getControlPortValue (uint32_t index) const override
+    {
+        const ScopedLock lock (getCallbackLock());
+
+        if (const auto* parameter = parameterValues.getParamByPortIndex (index))
+            return parameter->getDenormalisedValue();
+
+        if (const auto* port = findControlPortWithIndex (index))
+            return port->currentValue;
+
+        return std::nullopt;
+    }
+
+    bool setControlPortValue (uint32_t index, float value) override
+    {
+        const ScopedLock lock (getCallbackLock());
+        auto* port = findControlPortWithIndex (index);
+
+        if (port == nullptr || port->header.direction != Port::Direction::input)
+            return false;
+
+        if (auto* parameter = parameterValues.getParamByPortIndex (index))
+            parameter->setDenormalisedValue (value);
+        else
+            port->currentValue = value;
+
+        return true;
+    }
+
+    bool restoreState (const MemoryBlock& state) override
+    {
+        return setStateInformationImpl (state.getData(), (int) state.getSize(), ConcurrentWithAudioCallback::yes);
