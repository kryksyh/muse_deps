+class AudioUnitListenerLoop final : public DeletedAtShutdown
+{
+public:
+    static AudioUnitListenerLoop& get()
+    {
+        JUCE_ASSERT_MESSAGE_THREAD
+        if (instance == nullptr)
+            instance = new AudioUnitListenerLoop();
+        return *instance;
+    }
+
+    static void waitForPendingDisposals()
+    {
+        JUCE_ASSERT_MESSAGE_THREAD
+        if (instance != nullptr)
+            instance->flush();
+    }
+
+    void dispose (AUEventListenerRef listener, std::shared_ptr<void> context, AudioUnit unit)
+    {
+        ++pending;
+        auto* self = this;
+        CFRunLoopPerformBlock (loop, kCFRunLoopDefaultMode, ^
+        {
+            AUListenerDispose (listener);
+            MessageManager::callAsync ([self, context, unit]
+            {
+                if (unit != nullptr)
+                    AudioComponentInstanceDispose (unit);
+                --self->pending;
+            });
+        });
+        CFRunLoopWakeUp (loop);
+    }
+
+    CFRunLoopRef getRunLoop() const { return loop; }
+
+private:
+    AudioUnitListenerLoop()
+        : worker ([this]
+        {
+            Thread::setCurrentThreadName ("Audio Unit events");
+            loop = CFRunLoopGetCurrent();
+            CFRunLoopSourceContext sourceContext {};
+            auto source = CFRunLoopSourceCreate (kCFAllocatorDefault, 0, &sourceContext);
+            CFRunLoopAddSource (loop, source, kCFRunLoopDefaultMode);
+            auto* self = this;
+            CFRunLoopPerformBlock (loop, kCFRunLoopDefaultMode, ^ { self->ready.signal(); });
+            // Audio Unit timers can change without waking this run loop.
+            while (!stopping.load())
+                CFRunLoopRunInMode (kCFRunLoopDefaultMode, 0.01, false);
+            CFRunLoopRemoveSource (loop, source, kCFRunLoopDefaultMode);
+            CFRelease (source);
+        })
+    {
+        ready.wait();
+    }
+
+    ~AudioUnitListenerLoop() override
+    {
+        flush();
+        stopping.store (true);
+        CFRunLoopStop (loop);
+        CFRunLoopWakeUp (loop);
+        worker.join();
+        instance = nullptr;
+    }
+
+    void flush()
+    {
+        // Keep the main run loop available for the hosting service.
+        while (pending.load() != 0)
+            CFRunLoopRunInMode (kCFRunLoopDefaultMode, 0.01, true);
+    }
+
+    inline static AudioUnitListenerLoop* instance = nullptr;
+    WaitableEvent ready;
+    CFRunLoopRef loop = nullptr;
+    std::atomic<int> pending { 0 };
+    std::atomic<bool> stopping { false };
+    std::thread worker;
+};
