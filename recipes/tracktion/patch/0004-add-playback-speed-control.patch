+inline void PlayHead::setPlaybackRate (double ratio)
+{
+    jassert (ratio > 0.0);
+    const auto previous = currentRateChange.load (std::memory_order_acquire);
+    if (ratio == (previous != nullptr ? previous->ratio : 1.0))
+        return;
+
+    const auto start = referenceSampleRange.load().getEnd();
+    auto change = std::make_unique<RateChange> (RateChange { start, rateAdjustedReferencePosition (start), ratio, previous });
+    const auto result = change.get();
+    rateChanges.push_back (std::move (change));
+    currentRateChange.store (result, std::memory_order_release);
+}
+
+inline double PlayHead::getPlaybackRate() const noexcept
+{
+    const auto change = currentRateChange.load (std::memory_order_acquire);
+    return change != nullptr ? change->ratio : 1.0;
+}
+
+inline double PlayHead::rateAdjustedReferencePosition (int64_t referencePosition) const
+{
+    auto change = currentRateChange.load (std::memory_order_acquire);
+    while (change != nullptr && referencePosition < change->referenceStart)
+        change = change->previous;
+
+    return change != nullptr ? change->adjustedStart + (referencePosition - change->referenceStart) * change->ratio
+                             : static_cast<double> (referencePosition);
+}
+
+inline double PlayHead::referenceSamplePositionToTimelinePositionUnloopedFractional (int64_t referenceSamplePosition) const
+{
+    const auto syncPos = getSyncPositions();
+    return syncPos.playoutSyncPosition + (rateAdjustedReferencePosition (referenceSamplePosition)
+                                         - syncPos.rateAdjustedReferenceSyncPosition) * speed;
+}
