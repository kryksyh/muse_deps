+
+void TransportControl::setPaused (bool shouldPause)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+
+    if (shouldPause == isPaused() || ! isPlaying())
+        return;
+
+    const juce::ScopedLock lock (engine.getDeviceManager().deviceManager.getAudioCallbackLock());
+    paused.store (shouldPause, std::memory_order_release);
+
+    if (shouldPause)
+    {
+        const auto currentPosition = playHeadWrapper->getPosition();
+        playHeadWrapper->stop();
+        transportState->updatePositionFromPlayhead (currentPosition);
+    }
+    else
+    {
+        playHeadWrapper->play();
+    }
+
+    sendChangeMessage();
 }
 
