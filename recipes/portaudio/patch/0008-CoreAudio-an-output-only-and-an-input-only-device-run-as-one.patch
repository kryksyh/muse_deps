 /* =================================================================================================== */
 
+static CFStringRef CopyDeviceUID( AudioDeviceID device )
+{
+    AudioObjectPropertyAddress address = { kAudioDevicePropertyDeviceUID,
+                                           kAudioObjectPropertyScopeGlobal,
+                                           kAudioObjectPropertyElementMaster };
+    CFStringRef uid = NULL;
+    UInt32 size = sizeof( uid );
+    if( AudioObjectGetPropertyData( device, &address, 0, NULL, &size, &uid ) != noErr )
+        return NULL;
+    return uid;
+}
+
+static void SetInt( CFMutableDictionaryRef dictionary, const char *key, int value )
+{
+    CFStringRef k = CFStringCreateWithCString( NULL, key, kCFStringEncodingUTF8 );
+    CFNumberRef v = CFNumberCreate( NULL, kCFNumberIntType, &value );
+    CFDictionarySetValue( dictionary, k, v );
+    CFRelease( v );
+    CFRelease( k );
+}
+
+static void SetValue( CFMutableDictionaryRef dictionary, const char *key, CFTypeRef value )
+{
+    CFStringRef k = CFStringCreateWithCString( NULL, key, kCFStringEncodingUTF8 );
+    CFDictionarySetValue( dictionary, k, value );
+    CFRelease( k );
+}
+
+/* The aggregate device's channels are the two devices' channels: a channel map would need
+   them mapped through. */
+static int HasChannelMap( const PaStreamParameters *parameters )
+{
+    const PaMacCoreStreamInfo *info = (const PaMacCoreStreamInfo *)parameters->hostApiSpecificStreamInfo;
+    return info && info->channelMap;
+}
+
+/* A device for output and one for input as one private aggregate device: one audio unit and
+   one IO cycle serve both directions, so Core Audio keeps input and output aligned and no ring
+   buffer waits between them. The output device clocks it; the input device is drift
+   compensated. Returns kAudioObjectUnknown if Core Audio does not create it. */
+static AudioDeviceID CreateAggregateDevice( AudioDeviceID outputDevice, AudioDeviceID inputDevice )
+{
+    static int32_t count = 0;
+    AudioDeviceID aggregate = kAudioObjectUnknown;
+    CFStringRef outputUID = CopyDeviceUID( outputDevice );
+    CFStringRef inputUID = CopyDeviceUID( inputDevice );
+    if( outputUID && inputUID )
+    {
+        CFMutableDictionaryRef outputSub = CFDictionaryCreateMutable( NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                                      &kCFTypeDictionaryValueCallBacks );
+        CFMutableDictionaryRef inputSub = CFDictionaryCreateMutable( NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                                     &kCFTypeDictionaryValueCallBacks );
+        CFMutableDictionaryRef description = CFDictionaryCreateMutable( NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                                        &kCFTypeDictionaryValueCallBacks );
+        CFStringRef uid = CFStringCreateWithFormat( NULL, NULL, CFSTR( "org.portaudio.duplex.%d.%d" ),
+                                                    (int)getpid(), (int)OSAtomicIncrement32( &count ) );
+        const void *subDevices[2];
+        CFArrayRef subDeviceList;
+
+        SetValue( outputSub, kAudioSubDeviceUIDKey, outputUID );
+        SetInt( outputSub, kAudioSubDeviceDriftCompensationKey, 0 );
+        SetValue( inputSub, kAudioSubDeviceUIDKey, inputUID );
+        SetInt( inputSub, kAudioSubDeviceDriftCompensationKey, 1 );
+        subDevices[0] = outputSub;
+        subDevices[1] = inputSub;
+        subDeviceList = CFArrayCreate( NULL, subDevices, 2, &kCFTypeArrayCallBacks );
+
+        SetValue( description, kAudioAggregateDeviceNameKey, CFSTR( "PortAudio duplex" ) );
+        SetValue( description, kAudioAggregateDeviceUIDKey, uid );
+        SetInt( description, kAudioAggregateDeviceIsPrivateKey, 1 );
+        SetValue( description, kAudioAggregateDeviceSubDeviceListKey, subDeviceList );
+        SetValue( description, kAudioAggregateDeviceMasterSubDeviceKey, outputUID );
+#ifdef kAudioAggregateDeviceClockDeviceKey
+        SetValue( description, kAudioAggregateDeviceClockDeviceKey, outputUID );
+#endif
+        if( AudioHardwareCreateAggregateDevice( description, &aggregate ) != noErr )
+            aggregate = kAudioObjectUnknown;
+
+        CFRelease( subDeviceList );
+        CFRelease( uid );
+        CFRelease( description );
+        CFRelease( inputSub );
+        CFRelease( outputSub );
+    }
+    if( outputUID )
+        CFRelease( outputUID );
+    if( inputUID )
+        CFRelease( inputUID );
+    return aggregate;
+}
