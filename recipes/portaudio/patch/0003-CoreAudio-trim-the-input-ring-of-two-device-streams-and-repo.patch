 #define RING_BUFFER_EMPTY (1000)
 
+/* Called by the input ioproc after it wrote a block of inputFrames to the
+   ring buffer, captured at adcTime. */
+static void PublishInputStamp( PaMacCoreStream *stream, double adcTime, ring_buffer_size_t frames )
+{
+    stream->inputStampSequence++;
+    PaUtil_WriteMemoryBarrier();
+    stream->inputStampAdcTime = adcTime;
+    stream->inputStampFrame = stream->inputFramesWritten;
+    PaUtil_WriteMemoryBarrier();
+    stream->inputStampSequence++;
+    stream->inputFramesWritten += frames;
+    stream->inputRingReady = 1;
+}
+
+static int ReadInputStamp( PaMacCoreStream *stream, double *adcTime, int64_t *frame )
+{
+    const uint32_t before = stream->inputStampSequence;
+    PaUtil_ReadMemoryBarrier();
+    *adcTime = stream->inputStampAdcTime;
+    *frame = stream->inputStampFrame;
+    PaUtil_ReadMemoryBarrier();
+    return before != 0 && !( before & 1 ) && before == stream->inputStampSequence;
+}
+
+/* Called by the output ioproc when input comes from a separate device.
+   The ring buffer starts with an arbitrary fill that depends on when the two
+   devices started. Once input arrives, drop the excess so that the fill is
+   one host buffer more than this callback needs; this keeps the latency
+   low and the same on every start. Then correct inputBufferAdcTime, which
+   would otherwise ignore the time the input spends in the ring buffer. */
+static void SyncInputRing( PaMacCoreStream *stream, unsigned long outputFrames, PaStreamCallbackTimeInfo *timeInfo )
+{
+    double stampAdcTime;
+    int64_t stampFrame;
+
+    if( !stream->inputRingTrimmed && stream->inputRingReady )
+    {
+        const ring_buffer_size_t target =
+            MAX( stream->inputFramesPerBuffer, stream->outputFramesPerBuffer ) + outputFrames;
+        const ring_buffer_size_t available = PaUtil_GetRingBufferReadAvailable( &stream->inputRingBuffer );
+        if( available > target )
+        {
+            PaUtil_AdvanceRingBufferReadIndex( &stream->inputRingBuffer, available - target );
+            stream->inputFramesRead += available - target;
+        }
+        stream->inputRingTrimmed = 1;
+        stream->converterStartFrame = stream->inputFramesRead;
+    }
+
+    if( !stream->inputRingTrimmed || !ReadInputStamp( stream, &stampAdcTime, &stampFrame ) )
+        return;
+
+    if( stream->inputSRConverter )
+    {
+        /* The converter turns converterInputRate frames into sampleRate frames */
+        const double inputFrame = stream->converterStartFrame
+                                  + stream->converterOutputFrames * stream->converterInputRate / stream->sampleRate
+                                  - stream->converterLeadingFrames;
+        timeInfo->inputBufferAdcTime = stampAdcTime + ( inputFrame - stampFrame ) / stream->converterInputRate;
+        stream->converterOutputFrames += outputFrames;
+    }
+    else
+    {
+        timeInfo->inputBufferAdcTime = stampAdcTime + (double)( stream->inputFramesRead - stampFrame ) / stream->sampleRate;
+    }
+}
