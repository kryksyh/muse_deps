 // ------------------------------------------------------------------------------------------
+#ifdef __IAudioClient3_INTERFACE_DEFINED__
+// Windows 10 runs the shared engine at a shorter period than its default (10 ms) where the driver
+// supports it. Returns the period to request in frames, 0 if none is shorter than the default.
+static UINT32 _GetSharedLowLatencyPeriod(IAudioClient *client, const WAVEFORMATEX *format, UINT32 requestedFrames)
+{
+    UINT32 defaultFrames = 0, fundamentalFrames = 0, minFrames = 0, maxFrames = 0, frames;
+    HRESULT hr;
+
+    if ((requestedFrames == 0) || (GetAudioClientVersion() < 3))
+        return 0;
+    hr = IAudioClient3_GetSharedModeEnginePeriod((IAudioClient3 *)client, format, &defaultFrames,
+            &fundamentalFrames, &minFrames, &maxFrames);
+    PRINT(("WASAPI: shared engine periods: requested %u, default %u, fundamental %u, min %u, max %u (hr 0x%08X)\n",
+        requestedFrames, defaultFrames, fundamentalFrames, minFrames, maxFrames, (unsigned)hr));
+    if (FAILED(hr) || (fundamentalFrames == 0))
+        return 0;
+
+    frames = max(requestedFrames, minFrames);
+    frames = ((frames + fundamentalFrames - 1) / fundamentalFrames) * fundamentalFrames;
+    frames = min(frames, maxFrames);
+    return (frames < defaultFrames ? frames : 0);
+}
+#endif
